<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculatorWithDelegates.MainPage">

    <ScrollView>
        <Grid x:Name="MainRoot" BackgroundColor="Peru" Margin="3"
         RowDefinitions="*,*,*,*,*" ColumnDefinitions="*,*,*,*">


            <Label x:Name="textLabel" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Padding="10"
                Margin="2" FontSize="30" Background="LightCyan" FontFamily="CookieCrisp"/>
            <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource ButtonStyle}" Text="1"/>
            <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource ButtonStyle}" Text="2"/>
            <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource ButtonStyle}" Text="3"/>
            <Button Grid.Row="1" Grid.Column="3" FontSize="50" FontAttributes="Bold" 
                 BorderWidth="3" Padding="14,10" Background="Gray" Text="+" CornerRadius="50"/>

            <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource ButtonStyle}" Text="4"/>
            <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource ButtonStyle}" Text="5"/>
            <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource ButtonStyle}" Text="6"/>
            <Button Grid.Row="2" Grid.Column="3" FontSize="50" FontAttributes="Bold" 
                 BorderWidth="3" Padding="14,10" Background="Gray" Text="-" CornerRadius="50"/>

            <Button Grid.Row="3" Grid.Column="0" Style="{StaticResource ButtonStyle}" Text="7"/>
            <Button Grid.Row="3" Grid.Column="1" Style="{StaticResource ButtonStyle}" Text="8"/>
            <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource ButtonStyle}" Text="9"/>
            <Button Grid.Row="3" Grid.Column="3" FontSize="50" FontAttributes="Bold" 
                 BorderWidth="3" Padding="14,10" Background="Gray" Text="*" CornerRadius="50"/>

            <Button Grid.Row="4" Grid.Column="0" Style="{StaticResource ButtonStyle}" Text="0"/>
            <Button Grid.Row="4" Grid.Column="1" FontSize="50" FontAttributes="Bold" 
                 BorderWidth="3" Padding="14,10" Background="LightPink" Text="=" CornerRadius="50"/>
            <Button Grid.Row="4" Grid.Column="2" FontSize="50" FontAttributes="Bold" 
                 BorderWidth="3" Padding="14,10" Background="PeachPuff" Text="AC" CornerRadius="50"/>
            <Button Grid.Row="4" Grid.Column="3" FontSize="50" FontAttributes="Bold" 
                 BorderWidth="3" Padding="14,10" Background="Gray" Text="/" CornerRadius="50"/>
        </Grid>
    </ScrollView>

</ContentPage>
